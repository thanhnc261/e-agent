      "HostContext": {
        "additionalProperties": false,
        "description": "Provider-neutral, untrusted hints from an embedding host (UI architecture \u00a74.7).",
        "properties": {
          "host_kind": {
            "enum": [
              "standalone",
              "embedded"
            ],
            "title": "Host Kind",
            "type": "string"
          },
          "locale": {
            "anyOf": [
              {
                "maxLength": 16,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "page_url_origin": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Url Origin"
          },
          "resource_hints": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ResourceHint"
            },
            "maxItems": 10,
            "title": "Resource Hints",
            "type": "array"
          },
          "selection_text": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
