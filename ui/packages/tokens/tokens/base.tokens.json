{
  "palette": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "black": { "$value": "#000000" },
    "gray-50": { "$value": "#f7f7f8" },
    "gray-100": { "$value": "#ececef" },
    "gray-300": { "$value": "#c4c4cc" },
    "gray-600": { "$value": "#5b5b66" },
    "gray-800": { "$value": "#2a2a31" },
    "gray-900": { "$value": "#17171c" },
    "gray-950": { "$value": "#0e0e12" },
    "blue-300": { "$value": "#8db4ff" },
    "blue-600": { "$value": "#1f5bd6" },
    "blue-700": { "$value": "#1849ab" },
    "green-300": { "$value": "#7ad49a" },
    "green-700": { "$value": "#1b6b3a" },
    "red-300": { "$value": "#ff9a9a" },
    "red-700": { "$value": "#b42318" },
    "amber-300": { "$value": "#ffcc66" },
    "amber-800": { "$value": "#8a4b00" },
    "violet-300": { "$value": "#c4a8ff" },
    "violet-700": { "$value": "#5b2bb5" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["system-ui", "Segoe UI", "Roboto", "Noto Sans", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.8125, "unit": "rem" } },
      "md": { "$value": { "value": 0.9375, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 0.25, "unit": "rem" } },
    "sm": { "$value": { "value": 0.5, "unit": "rem" } },
    "md": { "$value": { "value": 0.75, "unit": "rem" } },
    "lg": { "$value": { "value": 1.25, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } }
  },
  "color": {
    "$type": "color",
    "surface": { "$value": "{palette.white}" },
    "surface-raised": { "$value": "{palette.gray-50}" },
    "border": { "$value": "{palette.gray-300}" },
    "text": { "$value": "{palette.gray-900}" },
    "text-muted": { "$value": "{palette.gray-600}" },
    "accent": { "$value": "{palette.blue-600}" },
    "accent-text": { "$value": "{palette.white}" },
    "focus": { "$value": "{palette.blue-700}" },
    "status": {
      "verified": { "$value": "{palette.green-700}" },
      "failed": { "$value": "{palette.red-700}" },
      "unknown": { "$value": "{palette.amber-800}" },
      "blocked": { "$value": "{palette.violet-700}" }
    }
  },
  "approval": {
    "$type": "color",
    "border": { "$value": "{color.accent}" },
    "material-change": { "$value": "{palette.amber-800}" }
  }
}
