{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 14, "unit": "px" } },
    "lg": { "$value": { "value": 22, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#1b1f3b14",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": {
        "color": "#1b1f3b1f",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 28, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "lg": {
      "$value": {
        "color": "#25253d2e",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 64, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "display": { "$value": { "value": 2.625, "unit": "rem" } },
      "xl": { "$value": { "value": 1.75, "unit": "rem" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 160, "unit": "ms" } },
    "base": { "$value": { "value": 260, "unit": "ms" } }
  }
}
