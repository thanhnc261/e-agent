      "data_classes": {
        "/input/properties/purchase_order_ref": "internal",
        "/output/properties/purchase_order_ref": "internal",
        "/output/properties/external_ref": "internal",
        "/output/properties/state": "internal",
        "/output/properties/revision": "internal",
        "/output/properties/supplier_ref": "internal",
        "/output/properties/product_ref": "internal",
        "/output/properties/quantity": "internal",
        "/output/properties/unit": "internal",
        "/output/properties/unit_price": "internal",
        "/output/properties/currency": "internal",
        "/output/properties/requested_date": "internal"
      }
