      "contract_id": "sales.quotation.read.v1",
      "effect": "read",
      "input_schema_id": "sales.QuotationQuery.v1",
      "output_schema_id": "sales.Quotations.v1",
      "description": "Read quotations by host operation key (verification read-back)",
      "agent_visible": false,
      "data_classes": {
        "/input/properties/operation_key": "internal",
        "/output/properties/quotations/items/properties/line_count": "internal",
