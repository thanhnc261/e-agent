      "data_classes": {
        "/input/properties/as_of": "internal",
        "/output/properties/as_of": "internal",
        "/output/properties/company": "internal",
        "/output/properties/invoices/items/properties/invoice_ref": "internal",
        "/output/properties/invoices/items/properties/external_ref": "internal",
        "/output/properties/invoices/items/properties/customer_ref": "internal",
        "/output/properties/invoices/items/properties/due_date": "internal",
        "/output/properties/invoices/items/properties/residual": "internal",
        "/output/properties/invoices/items/properties/currency": "internal"
      }
