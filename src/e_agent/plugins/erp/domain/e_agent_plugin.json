      "data_classes": {
        "/output/properties/teams/items/properties/team_ref": "internal",
        "/output/properties/teams/items/properties/name": "internal",
        "/output/properties/teams/items/properties/member_refs": "internal",
        "/output/properties/sources/items/properties/source_ref": "internal",
        "/output/properties/sources/items/properties/name": "internal"
      }
    },
