    {
      "contract_id": "receivables.overdue-invoices.answer.v1",
      "effect": "answer",
      "input_schema_id": "receivables.OverdueInvoicesAnswer.v1",
      "output_schema_id": "procurement.VerifiedAnswer.v1",
      "description": "Report overdue invoices and totals per currency as of a date; the host recomputes it",
      "data_classes": {
        "/input/properties/as_of": "internal",
        "/input/properties/overdue_invoice_refs": "internal",
        "/input/properties/totals/items/properties/currency": "internal",
        "/input/properties/totals/items/properties/total": "internal",
        "/input/properties/summary": "personal"
      }
