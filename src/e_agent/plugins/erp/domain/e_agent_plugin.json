        "/output/properties/customer_active": "internal",
        "/output/properties/product_ref": "internal",
        "/output/properties/product_saleable": "internal",
        "/output/properties/list_price": "internal",
        "/output/properties/currency": "internal",
        "/output/properties/unit": "internal"
      }
