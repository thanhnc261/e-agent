      "risk": "write_high",
      "reversibility": "irreversible",
      "data_classes": {
        "/input/properties/name": "personal",
        "/input/properties/contact_ref": "internal",
        "/input/properties/team_ref": "internal",
        "/input/properties/owner_ref": "internal",
        "/input/properties/source_ref": "internal",
        "/input/properties/expected_revenue": "internal"
      }
    },
