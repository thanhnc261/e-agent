      "reversibility": "irreversible",
      "data_classes": {
        "/input/properties/purchase_order_ref": "internal",
        "/input/properties/expected_revision": "internal",
        "/input/properties/quantity": "internal",
        "/input/properties/requested_date": "internal"
      }
    },
