      "data_classes": {
        "/input/properties/demand_ref": "internal",
        "/input/properties/product_ref": "internal",
        "/input/properties/offer_ref": "internal",
        "/input/properties/supplier_ref": "internal",
        "/input/properties/unit_price": "internal",
        "/input/properties/explanation": "personal"
      }
    },
