      "contract_id": "crm.lead.read.v1",
      "effect": "read",
      "input_schema_id": "crm.LeadQuery.v1",
      "output_schema_id": "crm.Leads.v1",
      "description": "Read leads by host operation key (verification read-back)",
      "agent_visible": false,
      "data_classes": {
        "/input/properties/operation_key": "internal",
        "/output/properties/leads/items/properties/external_ref": "internal",
        "/output/properties/leads/items/properties/operation_key": "internal",
        "/output/properties/leads/items/properties/name": "personal",
        "/output/properties/leads/items/properties/contact_ref": "internal",
        "/output/properties/leads/items/properties/team_ref": "internal",
        "/output/properties/leads/items/properties/owner_ref": "internal",
        "/output/properties/leads/items/properties/source_ref": "internal",
        "/output/properties/leads/items/properties/expected_revenue": "internal"
      }
