        "/input/properties/customer_ref": "internal",
        "/input/properties/product_ref": "internal",
        "/input/properties/quantity": "internal",
        "/input/properties/unit": "internal",
        "/input/properties/unit_price": "internal",
        "/input/properties/currency": "internal",
        "/input/properties/subtotal": "internal"
      }
    },
