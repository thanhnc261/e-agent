        "/input/properties/as_of": "internal",
        "/output/properties/as_of": "internal",
        "/output/properties/orders/items/properties/order_ref": "internal",
        "/output/properties/orders/items/properties/external_ref": "internal",
        "/output/properties/orders/items/properties/customer_ref": "internal",
        "/output/properties/orders/items/properties/promised_date": "internal",
        "/output/properties/orders/items/properties/delivery_status": "internal"
      }
