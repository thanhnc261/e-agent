        "/output/properties/orders/items/properties/external_ref": "internal",
        "/output/properties/orders/items/properties/operation_key": "internal",
        "/output/properties/orders/items/properties/state": "internal",
        "/output/properties/orders/items/properties/purchase_order_ref": "internal",
        "/output/properties/orders/items/properties/requested_date": "internal",
        "/output/properties/orders/items/properties/line_count": "internal",
        "/output/properties/orders/items/properties/product_ref": "internal",
        "/output/properties/orders/items/properties/supplier_ref": "internal",
        "/output/properties/orders/items/properties/quantity": "internal",
        "/output/properties/orders/items/properties/unit": "internal",
        "/output/properties/orders/items/properties/currency": "internal",
        "/output/properties/orders/items/properties/unit_price": "internal",
        "/output/properties/orders/items/properties/subtotal": "internal"
      }
