      "effect": "answer",
      "input_schema_id": "procurement.ShortageAnswer.v1",
      "output_schema_id": "procurement.VerifiedAnswer.v1",
      "description": "Report demand, available and inbound quantity and the resulting shortage; the host verifies it against fresh reads",
      "data_classes": {
        "/input/properties/demand_ref": "internal",
        "/input/properties/product_ref": "internal",
        "/input/properties/demand_quantity": "internal",
        "/input/properties/available": "internal",
        "/input/properties/inbound": "internal",
        "/input/properties/shortage": "internal"
      }
    },
