{
  "plugin_id": "domain-erp",
  "version": "0.1.0",
  "sdk_api": ">=1.0,<2.0",
  "factory": "e_agent.plugins.erp.domain.plugin:create_plugin",
  "kind": "domain",
  "provides_capabilities": [
    {
      "contract_id": "inventory.availability.read.v1",
      "effect": "read",
      "input_schema_id": "inventory.AvailabilityQuery.v1",
      "output_schema_id": "inventory.Availability.v1",
      "description": "Available and inbound quantity for one product in the scoped warehouse",
      "data_classes": {
        "/input/properties/product_ref": "internal",
        "/output/properties/product_ref": "internal",
        "/output/properties/available": "internal",
        "/output/properties/inbound": "internal",
        "/output/properties/unit": "internal"
      }
    },
    {
      "contract_id": "procurement.demand.read.v1",
      "effect": "read",
      "input_schema_id": "procurement.DemandQuery.v1",
      "output_schema_id": "procurement.Demand.v1",
      "description": "One procurement demand with requested date and budget",
      "data_classes": {
        "/input/properties/demand_ref": "internal",
        "/output/properties/demand_ref": "internal",
        "/output/properties/product_ref": "internal",
        "/output/properties/quantity": "internal",
        "/output/properties/unit": "internal",
        "/output/properties/requested_date": "internal",
        "/output/properties/budget": "internal",
        "/output/properties/currency": "internal"
      }
    },
    {
      "contract_id": "procurement.open-demands.read.v1",
      "effect": "read",
      "input_schema_id": "procurement.OpenDemandsQuery.v1",
      "output_schema_id": "procurement.OpenDemands.v1",
      "description": "List open procurement demands with their exact demand and product references; use it first when the user gives no demand reference",
      "data_classes": {
        "/output/properties/demands/items/properties/demand_ref": "internal",
        "/output/properties/demands/items/properties/product_ref": "internal",
        "/output/properties/demands/items/properties/product_name": "internal",
        "/output/properties/demands/items/properties/quantity": "internal",
        "/output/properties/demands/items/properties/unit": "internal",
        "/output/properties/demands/items/properties/requested_date": "internal",
        "/output/properties/complete": "internal"
      }
    },
    {
      "contract_id": "procurement.offers.read.v1",
      "effect": "read",
      "input_schema_id": "procurement.OfferQuery.v1",
      "output_schema_id": "procurement.Offers.v1",
      "description": "Supplier offers for a product, including approval status",
      "data_classes": {
        "/input/properties/product_ref": "internal",
        "/output/properties/product_ref": "internal",
        "/output/properties/offers/items/properties/offer_ref": "internal",
        "/output/properties/offers/items/properties/supplier_ref": "internal",
        "/output/properties/offers/items/properties/product_ref": "internal",
        "/output/properties/offers/items/properties/unit_price": "internal",
        "/output/properties/offers/items/properties/currency": "internal",
        "/output/properties/offers/items/properties/unit": "internal",
        "/output/properties/offers/items/properties/approved": "internal",
        "/output/properties/offers/items/properties/delivery_date": "internal"
      }
    },
    {
      "contract_id": "procurement.purchase-order.create-draft.v1",
      "effect": "write",
      "input_schema_id": "procurement.DraftPurchaseOrder.v1",
      "output_schema_id": "procurement.DraftPurchaseOrderRef.v1",
      "description": "Create exactly one draft purchase order; never confirms",
      "risk": "write_low",
      "reversibility": "irreversible",
      "data_classes": {
        "/input/properties/demand_ref": "internal",
        "/input/properties/product_ref": "internal",
        "/input/properties/supplier_ref": "internal",
        "/input/properties/offer_ref": "internal",
        "/input/properties/quantity": "internal",
        "/input/properties/unit": "internal",
        "/input/properties/currency": "internal",
        "/input/properties/unit_price": "internal",
        "/input/properties/subtotal": "internal",
        "/input/properties/requested_date": "internal"
      }
    },
    {
      "contract_id": "procurement.purchase-order.read.v1",
      "effect": "read",
      "input_schema_id": "procurement.PurchaseOrderQuery.v1",
      "output_schema_id": "procurement.PurchaseOrders.v1",
      "description": "Read purchase orders by host operation key (verification read-back)",
      "agent_visible": false,
      "data_classes": {
