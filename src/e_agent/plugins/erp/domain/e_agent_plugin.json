        "/output/properties/quotations/items/properties/operation_key": "internal",
        "/output/properties/quotations/items/properties/state": "internal",
        "/output/properties/quotations/items/properties/customer_ref": "internal",
        "/output/properties/quotations/items/properties/product_ref": "internal",
        "/output/properties/quotations/items/properties/quantity": "internal",
        "/output/properties/quotations/items/properties/unit": "internal",
        "/output/properties/quotations/items/properties/unit_price": "internal",
        "/output/properties/quotations/items/properties/currency": "internal",
        "/output/properties/quotations/items/properties/subtotal": "internal",
        "/output/properties/quotations/items/properties/sent": "internal"
      }
