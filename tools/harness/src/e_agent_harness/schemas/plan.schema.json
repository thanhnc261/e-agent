{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-agent.local/harness/plan.schema.json",
  "title": "Phase plan contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "plan_ref", "design_refs", "adrs", "toggles", "tasks"],
  "properties": {
    "phase": {"type": "string", "minLength": 1},
    "plan_ref": {"type": "string", "pattern": "\\.md$"},
    "design_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "adrs": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}$"}},
    "toggles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modes", "fallback"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "modes": {"type": "array", "items": {"enum": ["off", "shadow", "on"]}, "minItems": 1},
          "fallback": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "feature_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "feature_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
