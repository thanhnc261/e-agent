{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 400000,
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash"
    ],
    "deny": [
      "Bash(docker *odoo-bench*)",
      "Bash(docker compose -p odoo-bench *)",
      "Bash(docker exec odoo-bench*)",
      "Bash(docker exec * odoo-bench*)",
      "Bash(docker stop odoo-bench*)",
      "Bash(docker restart odoo-bench*)",
      "Bash(docker rm *odoo-bench*)",
      "Bash(docker kill odoo-bench*)",
      "Bash(docker stop $(*)",
      "Bash(docker kill $(*)",
      "Bash(docker restart $(*)",
      "Bash(docker rm $(*)",
      "Bash(docker rm -f $(*)",
      "Bash(docker system prune*)",
      "Bash(docker container prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker network prune*)",
      "Edit(archive/**)",
      "Edit(~/dev/lab/enterprise-agent/experiment/**)",
      "Read(//**/ERP-Bench/**/solution/**)",
      "Read(//**/ERP-Bench/**/tests/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/harness_hook.py status --format hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/harness_hook.py checkpoint --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/harness_hook.py check-scope --hook || exit 2",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/harness_hook.py close-check --hook || { test \"$E_AGENT_HARNESS_UNATTENDED\" = 1 && exit 2; exit 0; }",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
